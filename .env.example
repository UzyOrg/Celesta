# Celestea · variables de entorno
# Para probar SIN llaves ni Supabase: npm run dev:defensa
# .env.example no se carga automáticamente. Los proveedores mock no seleccionan
# el almacén en memoria ni sustituyen DEFENSA_SIGNING_SECRET.
#
# Copia este archivo a .env.local para desarrollar y NO lo subas con valores reales
# (.env.local ya está en .gitignore). En Vercel se ponen en Settings → Environment
# Variables. Aquí solo van nombres y ejemplos: ninguna llave real.

# ─── Supabase (ya existentes) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública del sitio, sin diagonal final (para armar los enlaces).
NEXT_PUBLIC_SITE_URL=https://celestea.example

# ─── /crear (ya existentes) ──────────────────────────────────────────────────
CREAR_RETEST_SIGNING_SECRET=
CREAR_CLASSIFIER_MODEL=
CREAR_CLASSIFIER_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# Defensas orales (/defensa, /revision y /api/defensa)
# ═════════════════════════════════════════════════════════════════════════════

# Mientras esté sin definir (o en 0), estas rutas se ocultan en producción.
# Ponlo en 1 solo para probar en un despliegue (el micrófono del teléfono pide HTTPS).
DEFENSA_PUBLICA=0

# Firma los enlaces: la sesión del alumno y el acceso del profesor. Mínimo 32
# caracteres aleatorios. Cambiarlo cierra todas las sesiones y los enlaces.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DEFENSA_SIGNING_SECRET=

# Vercel Cron la manda como "Authorization: Bearer <valor>" a /api/defensa/mantenimiento
# (borra el audio a los 7 días). Mínimo 16 caracteres aleatorios.
CRON_SECRET=

# Dónde se guarda todo. "supabase" (por defecto) o "memoria" (solo desarrollo y pruebas:
# lo guardado se pierde al reiniciar y no funciona en producción).
DEFENSA_ALMACEN=supabase

# ─── Modelo de lenguaje: arma el plan, clasifica cada turno y redacta el reporte ─
# openai | anthropic | mock  (mock = respuestas falsas, sin llave ni red)
DEFENSA_LLM_PROVIDER=mock
# Modelo para el plan y el reporte, y uno rápido para clasificar cada respuesta.
# Sin valor por defecto a propósito: elige uno actual del proveedor.
DEFENSA_LLM_MODEL=
DEFENSA_LLM_MODEL_CLASIFICADOR=
DEFENSA_OPENAI_API_KEY=
DEFENSA_ANTHROPIC_API_KEY=

# ─── Transcripción: debe dar confianza y momento por palabra ─────────────────
# elevenlabs (Scribe v2 por lotes, con la misma llave de la voz) | deepgram | assemblyai | mock
DEFENSA_STT_PROVIDER=mock
# Opcional. Deepgram usa nova-3 y ElevenLabs scribe_v2 si no se indica.
DEFENSA_STT_MODEL=
# Idioma que se le pide al transcriptor. "es" por defecto.
DEFENSA_STT_IDIOMA=es
DEFENSA_DEEPGRAM_API_KEY=
DEFENSA_ASSEMBLYAI_API_KEY=
# Una palabra con menos confianza que esto entra como posible parte por aclarar (0.1 a 0.95).
# El umbral definitivo sale de la etapa 1 del piloto.
DEFENSA_UMBRAL_CONFIANZA=0.55

# ─── Voz de Celestea ─────────────────────────────────────────────────────────
# elevenlabs | mock
DEFENSA_TTS_PROVIDER=mock
DEFENSA_ELEVENLABS_API_KEY=
DEFENSA_ELEVENLABS_VOICE_ID=
# Opcional. eleven_multilingual_v2 por defecto.
DEFENSA_ELEVENLABS_MODEL=
# Pon 1 si tu plan de ElevenLabs permite el modo sin registro (enable_logging=false).
DEFENSA_ELEVENLABS_SIN_REGISTRO=0

# ─── Solo con los proveedores "mock" (desarrollo y pruebas) ──────────────────
# Lo que "oye" el transcriptor falso cuando el audio no trae texto. Las palabras entre ~~ ~~
# salen con confianza baja y provocan la aclaración puntual.
# DEFENSA_MOCK_STT_TEXTO=
