{
  "name": "celesta",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.js --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test tests/e2e/api-hardening.spec.ts tests/e2e/production-surface.spec.ts",
    "test:e2e": "playwright test",
    "ci:verify": "pnpm run typecheck && pnpm run lint && pnpm run lint:workshops && pnpm run test && pnpm run build",
    "lint:workshops": "node ./scripts/workshop-lint.mjs",
    "evidence:analyze": "node scripts/analyze-ssr-logs.mjs ./docs/evidence/ssr.log > ./docs/evidence/ssr_analyze.txt",
    "evidence:check": "node -e \"const fs=require('fs');const need=['ssr.log','ssr_analyze.txt','export.csv','rate_limit_csv_429.txt','rate_limit_ingest_429.txt','transparency.json','explain_analyze_teacher.txt','explain_analyze_student.txt'];const miss=need.filter(f=>!fs.existsSync('docs/evidence/'+f));console.log(miss.length?('Faltan: '+miss.join(', ')):'OK');\"",
    "pilot:export": "tsx scripts/export-crear-pilot.ts",
    "invite:teacher": "tsx scripts/invite-teacher.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@nivo/core": "^0.99.0",
    "@nivo/radar": "^0.99.0",
    "@nivo/tooltip": "^0.99.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.57.0",
    "react-hot-toast": "^2.5.2",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.16",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.18",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.5.3"
  }
}
